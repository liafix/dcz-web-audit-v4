{
  "name": "dcz-webaudit-next",
  "version": "4.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run verify:workspace && npm run lint && npm run typecheck && npm run test && npm run build",
    "release:gate": "npm run check && npm audit --omit=dev --audit-level=high",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "admin:hash": "node scripts/hash-admin-password.mjs",
    "verify:source": "npm run verify:workspace",
    "verify:workspace": "node scripts/verify-source.mjs --mode=workspace",
    "verify:release": "node scripts/verify-source.mjs --mode=release",
    "verify:lockfile": "node scripts/verify-lockfile.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "cheerio": "1.2.0",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.2",
    "ipaddr.js": "2.2.0",
    "next": "15.5.22",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "resend": "6.18.0",
    "server-only": "0.0.1",
    "undici": "7.28.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.10",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "drizzle-kit": "0.31.10",
    "eslint": "9.38.0",
    "eslint-config-next": "15.5.22",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vitest": "4.0.4"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "packageManager": "npm@10.9.4"
}
