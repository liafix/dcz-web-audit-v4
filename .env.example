# Public application URL. Use the Hostinger temporary/staging URL or Vercel Preview URL during QA and https://dczweb.com in Production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Keep true on local/Preview. Set false only on the verified production domain.
NEXT_PUBLIC_PREVENT_INDEXING=true

# Neon or another PostgreSQL connection string with TLS.
DATABASE_URL=

# Transactional e-mail (Resend).
RESEND_API_KEY=
MAIL_FROM="DCZ WebAudit <audit@dczweb.com>"
DCZ_NOTIFICATION_EMAIL=info@dcz.sk

# Cloudflare Turnstile. Production must use TURNSTILE_ENABLED=true and both keys.
TURNSTILE_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional PageSpeed API. The audit works without it.
GOOGLE_PAGESPEED_API_KEY=

# Generate independent random secrets, at least 32 bytes each.
REQUEST_FINGERPRINT_SECRET=
ACCESS_COOKIE_SECRET=
ADMIN_SESSION_SECRET=

# Admin. Generate the hash: npm run admin:hash -- "very-strong-password-16-plus"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Secret for Hostinger cron jobs, Vercel Cron or another trusted scheduler.
CRON_SECRET=

# HTTPS webhook for redacted structured production error events.
MONITORING_WEBHOOK_URL=
# High-end revenue funnel. Use an HTTPS Cal.com, Calendly or Google booking URL.
DIAGNOSTIC_BOOKING_URL=
# Booking provider/adaptor webhook bearer secret. Keep set even when booking is initially marked manually in admin.
BOOKING_WEBHOOK_SECRET=
